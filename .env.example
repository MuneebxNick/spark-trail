# Database Connections (Neon Hosted PostgreSQL)
# Pooled connection URL for serverless application queries
DATABASE_URL="postgresql://user:password@ep-cool-pool-123456-pooler.us-east-2.aws.neon.tech/sparktrail?sslmode=require"

# Direct connection URL for Prisma migrations & schema pushing
DIRECT_URL="postgresql://user:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/sparktrail?sslmode=require"

# Authentication Secret (Minimum 32 random characters for JWT signing)
JWT_SECRET="sparktrail_super_secret_jwt_key_must_be_32_chars_minimum"


# Cloudinary Media Storage (Server-side image upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
